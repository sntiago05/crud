<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="productos.crud.controller.ProductoController">

    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Gestión de productos" />

            <!-- Formulario de registro -->
            <HBox alignment="CENTER" spacing="10.0">
                <TextField fx:id="campoNombre" promptText="Nombre" />
                <TextField fx:id="campoPrecio" promptText="Precio" />
                <TextField fx:id="campoStock" promptText="Stock" />
                <Button onAction="#onRegistrarClick" text="Registrar" />
            </HBox>

            <!-- Búsqueda -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <TextField fx:id="campoBusqueda" promptText="Buscar por nombre" HBox.hgrow="ALWAYS" />
                <Button onAction="#onBuscarClick" text="Buscar" />
                <Button onAction="#onListarClick" text="Listar todos" />
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tablaProductos">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="354.3999710083008" text="Nombre" />
                <TableColumn fx:id="colPrecio" prefWidth="101.60000610351562" text="Precio" />
                <TableColumn fx:id="colStock" prefWidth="144.7999267578125" text="Stock" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </BorderPane.margin>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <Button onAction="#onActualizarStockClick" text="Actualizar stock del seleccionado" />
            <Button onAction="#onEliminarClick" style="-fx-text-fill: #b00020;" text="Eliminar seleccionado" />
        </HBox>
    </bottom>

</BorderPane>
